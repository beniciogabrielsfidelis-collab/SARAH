                # =================================================

                st.session_state.resultado = resultado


                st.session_state.dados_triagem = {

                    "nome": nome,
                    "idade_valor": idade_valor,
                    "unidade_idade": unidade_idade,
                    "idade_anos": idade_anos,
                    "peso": peso,
                    "altura": altura,
                    "imc": imc,
                    "temperatura": temperatura_final,
                    "spo2": spo2_final,
                    "pressao_sistolica": pressao_sistolica_final,
                    "pressao_diastolica": pressao_diastolica_final,
                    "frequencia_cardiaca": frequencia_final,
                    "sintomas": sintomas,
                    "opcoes": opcoes,
                    "doenca_cronica": doenca_cronica,
                    "usa_medicamento": usa_medicamento,
                }


                # =================================================
                # HISTÓRICO
                # =================================================

                agora = datetime.datetime.now().strftime(
                    "%d/%m/%Y %H:%M"
                )


                registro = {

                    "nome": nome,

                    "hora": agora,

                    "idade": idade_anos,

                    "prioridade":
                        resultado["prioridade"],

                    "score":
                        resultado["score"],

                    "imc":
                        round(imc, 1),

                }


                st.session_state.historico.append(
                    registro
                )


                st.success(
                    "Triagem analisada com sucesso."
                )


    # ========================================================
    # VOLTAR
    # ========================================================

    with col2:

        if st.button(
            "VOLTAR",
            use_container_width=True
        ):

            voltar_menu()


    # ========================================================
    # RENDERIZAÇÃO DO RESULTADO
    #
    # IMPORTANTE:
    # Fica FORA do botão ANALISAR.
    # ========================================================

    if st.session_state.resultado is not None:

        resultado = st.session_state.resultado

        dados = st.session_state.dados_triagem


        st.divider()


        # ====================================================
        # FICHA
        # ====================================================

        st.subheader(
            "FICHA DE ATENDIMENTO"
        )


        idade_exibicao = (
            f"{dados['idade_valor']} "
            f"{dados['unidade_idade'].lower()}"
        )


        st.markdown(
            f"""
            <div class="ficha">

            <b>Paciente:</b> {dados['nome']}<br>
            <b>Idade:</b> {idade_exibicao}<br>
            <b>Peso:</b> {dados['peso']:.1f} kg<br>
            <b>Altura:</b> {dados['altura']:.2f} m<br>
            <b>IMC calculado:</b> {dados['imc']:.1f}

            </div>
            """,
            unsafe_allow_html=True
        )


        # ====================================================
        # SINAIS VITAIS
        # ====================================================

        st.write("### Sinais vitais")


        if dados["temperatura"] is not None:

            st.write(
                f"**Temperatura:** "
                f"{dados['temperatura']:.1f} °C"
            )

        else:

            st.write(
                "**Temperatura:** não informada"
            )


        if dados["spo2"] is not None:

            st.write(
                f"**SpO₂:** "
                f"{dados['spo2']}%"
            )

        else:

            st.write(
                "**SpO₂:** não informada"
            )


        if dados["pressao_sistolica"] is not None:

            st.write(
                f"**Pressão arterial:** "
                f"{dados['pressao_sistolica']}/"
                f"{dados['pressao_diastolica']} mmHg"
            )

        else:

            st.write(
                "**Pressão arterial:** não informada"
            )


        if dados["frequencia_cardiaca"] is not None:

            st.write(
                f"**Frequência cardíaca:** "
                f"{dados['frequencia_cardiaca']} bpm"
            )

        else:

            st.write(
                "**Frequência cardíaca:** não informada"
            )


        # ====================================================
        # IMC
        # ====================================================

        st.write("### Indicador corporal")


        if dados["idade_anos"] < 20:

            st.info(
                "Para menores de 20 anos, o IMC não é "
                "interpretado pela classificação adulta. "
                "A avaliação adequada depende de idade, "
                "sexo e curvas de crescimento."
            )

        else:

            st.write(
                f"**IMC:** {dados['imc']:.1f}"
            )


        # ====================================================
        # SINTOMAS
        # ====================================================

        st.write("### Sintomas informados")


        if dados["opcoes"]:

            for sintoma in dados["opcoes"]:

                st.write(
                    f"• {sintoma}"
                )


        if dados["sintomas"].strip():

            st.write(
                f"**Descrição:** "
                f"{dados['sintomas']}"
            )


        st.divider()


        # ====================================================
        # RESULTADO
        # ====================================================

        st.subheader(
            f"{resultado['simbolo']} "
            f"{resultado['titulo']}"
        )


        st.write(
            f"**Classificação:** "
            f"{resultado['prioridade']}"
        )


        st.write(
            f"**Pontuação interna:** "
            f"{resultado['score']}"
        )


        st.write(
            f"**Orientação:** "
            f"{resultado['orientacao']}"
        )


        # ====================================================
        # MOTIVOS DE EMERGÊNCIA
        # ====================================================

        if resultado["motivos_emergencia"]:

            st.error(
                "Fatores que acionaram o alerta de emergência:"
            )

            for motivo in resultado["motivos_emergencia"]:

                st.write(
                    f"• {motivo}"
                )


        # ====================================================
        # INDICADOR DE RISCO
        # ====================================================

        risco = min(
            resultado["score"] * 15,
            100
        )


        st.write(
            "### Indicador interno de triagem"
        )


        st.progress(risco)


        st.caption(
            f"Índice interno: {risco}%"
        )


        # ====================================================
        # OBSERVAÇÕES
        # ====================================================

        if resultado["observacoes"]:

            st.write(
                "### Observações"
            )


            for observacao in resultado["observacoes"]:

                st.write(
                    f"• {observacao}"
                )


        # ====================================================
        # EMERGÊNCIA
        # ====================================================

        if resultado["prioridade"] == "Vermelho":

            st.error(
                "POSSÍVEL SITUAÇÃO DE EMERGÊNCIA"
            )


            st.warning(
                "Esta classificação é apenas um apoio "
                "experimental à triagem e não substitui "
                "uma avaliação profissional."
            )


            st.write(
                "### Unidades próximas"
            )


            loc = streamlit_geolocation()


            if (
                loc
                and loc.get("latitude") is not None
                and loc.get("longitude") is not None
            ):

                user_lat = loc["latitude"]
                user_lon = loc["longitude"]


                hospitais_com_dados = []


                for hospital in HOSPITAIS:

                    distancia = calcular_distancia(
                        user_lat,
                        user_lon,
                        hospital["lat"],
                        hospital["lon"]
                    )


                    tempo = max(
                        1,
                        round(
                            (distancia / 30) * 60
                        )
                    )


                    hospitais_com_dados.append(
                        (
                            distancia,
                            tempo,
                            hospital
                        )
                    )


                hospitais_com_dados.sort(
                    key=lambda x: x[0]
                )


                for (
                    distancia,
                    tempo,
                    hospital
                ) in hospitais_com_dados[:2]:

                    maps_url = (
                        "https://www.google.com/maps/"
                        "search/?api=1&query="
                        f"{hospital['lat']},"
                        f"{hospital['lon']}"
                    )


                    st.markdown(
                        f"""
                        🏥 **{hospital['nome']}**

                        Distância aproximada:
                        **{distancia:.1f} km**

                        Tempo estimado:
                        **~{tempo} min**

                        {hospital['endereco']}

                        [Abrir no Google Maps]({maps_url})
                        """
                    )


                    st.divider()


            else:

                st.info(
                    "Permita o acesso à localização "
                    "para calcular as distâncias."
                )


                for hospital in HOSPITAIS:

                    st.write(
                        f"🏥 **{hospital['nome']}**"
                    )

                    st.caption(
                        hospital["endereco"]
                    )


        elif resultado["prioridade"] == "Amarelo":

            st.warning(
                "NECESSITA DE AVALIAÇÃO"
            )


        else:

            st.success(
                "BAIXA PRIORIDADE"
            )


        # ====================================================
        # AVISO EDUCACIONAL
        # ====================================================

        st.info(
            "A SARAH é um protótipo educacional de apoio "
            "à triagem. Ela não realiza diagnósticos médicos "
            "e não substitui profissionais de saúde."
        )


# ============================================================
# HISTÓRICO
# ============================================================

elif st.session_state.pagina == "historico":

    st.title("📊 Histórico de Atendimentos")


    if not st.session_state.historico:

        st.info(
            "Nenhum atendimento registrado."
        )


    else:

        for item in reversed(
            st.session_state.historico
        ):

            if item["prioridade"] == "Vermelho":

                simbolo = "🔴"

            elif item["prioridade"] == "Amarelo":

                simbolo = "🟡"

            else:

                simbolo = "🟢"


            with st.expander(
                f"{simbolo} "
                f"{item['nome']} — "
                f"{item['prioridade']} — "
                f"{item['hora']}"
            ):

                st.write(
                    f"**Paciente:** "
                    f"{item['nome']}"
                )

                st.write(
                    f"**Idade:** "
                    f"{item['idade']:.1f} anos"
                )

                st.write(
                    f"**Horário:** "
                    f"{item['hora']}"
                )

                st.write(
                    f"**Classificação:** "
                    f"{item['prioridade']}"
                )

                st.write(
                    f"**Pontuação:** "
                    f"{item['score']}"
                )

                st.write(
                    f"**IMC:** "
                    f"{item['imc']}"
                )


    st.divider()


    if st.button(
        "⬅️ VOLTAR AO MENU",
        use_container_width=True
    ):

        voltar_menu()


# ============================================================
# RODAPÉ
# ============================================================

st.markdown(
    """
    <div class="rodape">
    SARAH — Sistema de Apoio e Resposta Rápida ao Atendimento Hospitalar<br>
    Protótipo desenvolvido para fins educacionais e científicos.
    </div>
    """,
    unsafe_allow_html=True
)
