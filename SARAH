# ============================================================
# NORMALIZAÇÃO DE TEXTO
# ============================================================

def normalizar_texto(texto):

    texto = texto.lower().strip()

    substituicoes = {
        "á": "a",
        "à": "a",
        "ã": "a",
        "â": "a",
        "é": "e",
        "ê": "e",
        "í": "i",
        "ó": "o",
        "ô": "o",
        "õ": "o",
        "ú": "u",
        "ç": "c",
    }

    for antigo, novo in substituicoes.items():
        texto = texto.replace(antigo, novo)

    return texto


# ============================================================
# DETECÇÃO MAIS SEGURA DE SINTOMAS
# ============================================================

def possui_sintoma(texto, sintoma):

    texto = normalizar_texto(texto)
    sintoma = normalizar_texto(sintoma)

    # Expressões que indicam ausência do sintoma.
    negativas = [
        f"nao tenho {sintoma}",
        f"nao estou com {sintoma}",
        f"sem {sintoma}",
        f"nao sinto {sintoma}",
        f"nao apresento {sintoma}",
        f"nega {sintoma}",
    ]

    for negativa in negativas:

        if negativa in texto:
            return False

    return sintoma in texto


# ============================================================
# FUNÇÃO PARA VERIFICAR SINTOMA
# ============================================================

def sintoma_presente(texto, selecionados, sintoma):

    texto_presente = possui_sintoma(
        texto,
        sintoma
    )

    selecionado = (
        normalizar_texto(sintoma)
        in [
            normalizar_texto(s)
            for s in selecionados
        ]
    )

    return texto_presente or selecionado


# ============================================================
# ANÁLISE DE SINAIS VITAIS
# ============================================================

def analisar_sinais_vitais(
    idade_anos,
    temperatura,
    pressao_sistolica,
    pressao_diastolica,
    frequencia_cardiaca,
    spo2
):

    alertas = []

    # --------------------------------------------------------
    # TEMPERATURA
    # --------------------------------------------------------

    if temperatura is not None:

        if temperatura >= 39.5:

            alertas.append(
                "Temperatura corporal elevada."
            )

        elif temperatura < 35.0:

            alertas.append(
                "Temperatura corporal abaixo do esperado."
            )

    # --------------------------------------------------------
    # SATURAÇÃO
    # --------------------------------------------------------

    if spo2 is not None:

        if spo2 < 90:

            alertas.append(
                "Saturação de oxigênio muito baixa."
            )

        elif spo2 < 94:

            alertas.append(
                "Saturação de oxigênio abaixo do valor de referência utilizado pelo protótipo."
            )

    # --------------------------------------------------------
    # PRESSÃO ARTERIAL
    # --------------------------------------------------------

    if pressao_sistolica is not None:

        if pressao_sistolica < 90:

            alertas.append(
                "Pressão sistólica baixa."
            )

        elif pressao_sistolica >= 180:

            alertas.append(
                "Pressão sistólica muito elevada."
            )

    if pressao_diastolica is not None:

        if pressao_diastolica >= 120:

            alertas.append(
                "Pressão diastólica muito elevada."
            )

    # --------------------------------------------------------
    # FREQUÊNCIA CARDÍACA
    # --------------------------------------------------------

    if frequencia_cardiaca is not None:

        if frequencia_cardiaca < 50:

            alertas.append(
                "Frequência cardíaca abaixo da faixa utilizada pelo protótipo."
            )

        elif frequencia_cardiaca > 120:

            alertas.append(
                "Frequência cardíaca elevada."
            )

    return alertas


# ============================================================
# FUNÇÃO PRINCIPAL DE ANÁLISE
# ============================================================

def analisar_triagem(
    sintomas_texto,
    sintomas_selecionados,
    idade_anos,
    imc,
    doenca_cronica,
    usa_medicamento,
    temperatura=None,
    pressao_sistolica=None,
    pressao_diastolica=None,
    frequencia_cardiaca=None,
    spo2=None
):

    texto = sintomas_texto

    score = 0

    observacoes = []

    emergencia_direta = False

    motivos_emergencia = []


    # ========================================================
    # SINTOMAS
    # ========================================================

    sintomas_leves = {
        "febre": 1,
        "tosse": 1,
        "coriza": 1,
        "dor de cabeça": 1,
        "dor no corpo": 1,
        "fadiga": 1,
        "dor de garganta": 1,
    }

    sintomas_moderados = {
        "manchas na pele": 2,
        "coceira": 2,
        "inchaço": 2,
        "ínguas": 2,
    }

    sintomas_graves = {
        "dor no peito": 5,
        "falta de ar": 5,
        "visão alterada": 4,
    }


    # ========================================================
    # PONTUAÇÃO
    # ========================================================

    for sintoma, pontos in sintomas_leves.items():

        if sintoma_presente(
            texto,
            sintomas_selecionados,
            sintoma
        ):

            score += pontos


    for sintoma, pontos in sintomas_moderados.items():

        if sintoma_presente(
            texto,
            sintomas_selecionados,
            sintoma
        ):

            score += pontos


    for sintoma, pontos in sintomas_graves.items():

        if sintoma_presente(
            texto,
            sintomas_selecionados,
            sintoma
        ):

            score += pontos


    # ========================================================
    # SINAIS DE ALERTA DIRETO
    # ========================================================

    sinais_criticos = [
        (
            "dor no peito",
            "Dor no peito relatada."
        ),
        (
            "falta de ar",
            "Falta de ar relatada."
        ),
        (
            "visão alterada",
            "Alteração visual relatada."
        ),
    ]

    for sintoma, motivo in sinais_criticos:

        if sintoma_presente(
            texto,
            sintomas_selecionados,
            sintoma
        ):

            emergencia_direta = True
            motivos_emergencia.append(motivo)


    # ========================================================
    # COMBINAÇÕES
    # ========================================================

    febre = sintoma_presente(
        texto,
        sintomas_selecionados,
        "febre"
    )

    dor_corpo = sintoma_presente(
        texto,
        sintomas_selecionados,
        "dor no corpo"
    )

    tosse = sintoma_presente(
        texto,
        sintomas_selecionados,
        "tosse"
    )


    if febre and dor_corpo:

        score += 1

        observacoes.append(
            "Combinação de sintomas identificada."
        )


    if febre and tosse:

        score += 1

        observacoes.append(
            "Febre associada à tosse identificada."
        )


    # ========================================================
    # SINAIS VITAIS
    # ========================================================

    alertas_vitais = analisar_sinais_vitais(
        idade_anos,
        temperatura,
        pressao_sistolica,
        pressao_diastolica,
        frequencia_cardiaca,
        spo2
    )


    observacoes.extend(alertas_vitais)


    # Valores considerados críticos pelo protótipo.
    # Eles não representam um protocolo médico oficial.

    if spo2 is not None and spo2 < 90:

        emergencia_direta = True

        motivos_emergencia.append(
            "Saturação de oxigênio muito baixa."
        )


    if pressao_sistolica is not None and pressao_sistolica < 80:

        emergencia_direta = True

        motivos_emergencia.append(
            "Pressão sistólica muito baixa."
        )


    # ========================================================
    # CLASSIFICAÇÃO BASE
    # ========================================================

    if emergencia_direta or score >= 6:

        prioridade = "Vermelho"
        simbolo = "🔴"
        titulo = "ATENÇÃO IMEDIATA"

        orientacao = (
            "Procure atendimento de emergência imediatamente. "
            "Em situações graves, acione o SAMU pelo 192."
        )

    elif score >= 3:

        prioridade = "Amarelo"
        simbolo = "🟡"
        titulo = "NECESSITA AVALIAÇÃO"

        orientacao = (
            "Recomenda-se procurar uma unidade de saúde "
            "para avaliação profissional."
        )

    else:

        prioridade = "Verde"
        simbolo = "🟢"
        titulo = "BAIXA PRIORIDADE"

        orientacao = (
            "Monitore os sintomas e procure atendimento "
            "se houver piora ou persistência."
        )


    # ========================================================
    # IDADE
    # ========================================================

    if idade_anos < 1:

        observacoes.append(
            "Paciente com menos de 1 ano: faixa etária que requer atenção adicional."
        )

        if prioridade == "Verde":

            prioridade = "Amarelo"
            simbolo = "🟡"
            titulo = "NECESSITA AVALIAÇÃO"


    elif idade_anos < 5:

        observacoes.append(
            "Criança pequena: faixa etária que requer atenção adicional."
        )

        if prioridade == "Verde":

            prioridade = "Amarelo"
            simbolo = "🟡"
            titulo = "NECESSITA AVALIAÇÃO"


    elif idade_anos >= 60:

        observacoes.append(
            "Pessoa idosa: faixa etária que requer atenção adicional."
        )

        if prioridade == "Verde":

            prioridade = "Amarelo"
            simbolo = "🟡"
            titulo = "NECESSITA AVALIAÇÃO"


    # ========================================================
    # DOENÇA CRÔNICA
    # ========================================================

    if doenca_cronica:

        observacoes.append(
            "Paciente informou possuir condição crônica."
        )

        if prioridade == "Verde":

            prioridade = "Amarelo"
            simbolo = "🟡"
            titulo = "NECESSITA AVALIAÇÃO"


    # ========================================================
    # MEDICAMENTOS
    # ========================================================

    if usa_medicamento:

        observacoes.append(
            "Paciente informou uso contínuo de medicamentos."
        )


    # ========================================================
    # IMC
    # ========================================================

    classificacao_imc = None

    if imc is not None:

        # ----------------------------------------------------
        # CRIANÇAS E ADOLESCENTES
        # ----------------------------------------------------

        if idade_anos < 20:

            classificacao_imc = (
                "IMC registrado. Para menores de 20 anos, "
                "a interpretação adequada depende de idade, sexo "
                "e curvas de crescimento/percentis."
            )

            observacoes.append(
                "O IMC não foi utilizado como classificação "
                "clínica automática por se tratar de paciente "
                "com menos de 20 anos."
            )

        # ----------------------------------------------------
        # ADULTOS
        # ----------------------------------------------------

        else:

            if imc >= 40:

                classificacao_imc = (
                    "IMC muito elevado."
                )

                observacoes.append(
                    "IMC muito elevado: o dado deve ser considerado "
                    "junto aos demais fatores clínicos."
                )

                # IMC muito elevado não transforma sozinho
                # um caso em emergência.
                # Porém, impede que o caso permaneça Verde.

                if prioridade == "Verde":

                    prioridade = "Amarelo"
                    simbolo = "🟡"
                    titulo = "NECESSITA AVALIAÇÃO"


            elif imc >= 30:

                classificacao_imc = (
                    "IMC acima da faixa de referência para adultos."
                )

                observacoes.append(
                    "IMC acima da faixa de referência para adultos."
                )


            elif imc < 18.5:

                classificacao_imc = (
                    "IMC abaixo da faixa de referência para adultos."
                )

                observacoes.append(
                    "IMC abaixo da faixa de referência para adultos."
                )


            else:

                classificacao_imc = (
                    "IMC dentro da faixa de referência utilizada "
                    "para adultos."
                )


    # ========================================================
    # PROPORÇÃO PESO / ALTURA
    # ========================================================

    indicador_proporcional = None

    if idade_anos >= 20 and imc is not None:

        if imc >= 50:

            indicador_proporcional = (
                "Relação peso-altura extremamente elevada."
            )

            observacoes.append(
                "A relação entre peso e altura apresenta "
                "valor extremamente elevado."
            )

            if prioridade == "Verde":

                prioridade = "Amarelo"
                simbolo = "🟡"
                titulo = "NECESSITA AVALIAÇÃO"


        elif imc >= 40:

            indicador_proporcional = (
                "Relação peso-altura muito elevada."
            )


    # ========================================================
    # RESULTADO
    # ========================================================

    return {
        "score": score,
        "prioridade": prioridade,
        "simbolo": simbolo,
        "titulo": titulo,
        "orientacao": orientacao,
        "observacoes": observacoes,
        "motivos_emergencia": motivos_emergencia,
        "classificacao_imc": classificacao_imc,
        "indicador_proporcional": indicador_proporcional,
    }


